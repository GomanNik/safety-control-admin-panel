            errors.append("HEADWEAR_MIN_CROP_ASPECT_RATIO must be > 0")
        if self.headwear_max_crop_aspect_ratio <= self.headwear_min_crop_aspect_ratio:
            errors.append("HEADWEAR_MAX_CROP_ASPECT_RATIO must be > HEADWEAR_MIN_CROP_ASPECT_RATIO")
        if not _in_unit_interval(self.headwear_max_crop_width_to_person_ratio):
            errors.append("HEADWEAR_MAX_CROP_WIDTH_TO_PERSON_RATIO must be in [0, 1]")
        if not _in_unit_interval(self.headwear_max_crop_height_to_person_ratio):
            errors.append("HEADWEAR_MAX_CROP_HEIGHT_TO_PERSON_RATIO must be in [0, 1]")

        if self.person_detector_mode.strip().lower() not in {
            "auto",
            "placeholder",
            "ultralytics",
            "ultralytics_yolo",
            "yolo",
            "onnx",
            "onnx_detector",
        }:
            errors.append("PERSON_DETECTOR_MODE has unsupported value")
        if self.person_onnx_input_width <= 0 or self.person_onnx_input_height <= 0:
            errors.append("PERSON_ONNX_INPUT_WIDTH and PERSON_ONNX_INPUT_HEIGHT must be > 0")
        if self.person_detector_box_format.strip().lower() not in {"cxcywh", "xyxy"}:
            errors.append("PERSON_DETECTOR_BOX_FORMAT must be cxcywh or xyxy")
        if self.person_detector_has_objectness not in {"auto", "true", "false"}:
            errors.append("PERSON_DETECTOR_HAS_OBJECTNESS must be auto/true/false")
        if self.person_detector_num_classes < 0:
            errors.append("PERSON_DETECTOR_NUM_CLASSES must be >= 0")

        if self.person_tracking_backend.strip().lower() not in {
            "ultralytics",
            "yolo",
            "yolo_track",
            "botsort",
            "bytetrack",
            "development_simple",
            "simple",
            "dev_simple",
            "test",
            "disabled",
            "none",
            "off",
        }:
            errors.append("PERSON_TRACKING_BACKEND has unsupported value")
        if not _in_unit_interval(self.person_tracking_min_confidence):
            errors.append("PERSON_TRACKING_MIN_CONFIDENCE must be in [0, 1]")
        if self.person_tracking_person_class_id < 0:
            errors.append("PERSON_TRACKING_PERSON_CLASS_ID must be >= 0")
        if self.person_tracking_require_external and self.person_tracking_backend.strip().lower() in {
            "development_simple",
            "simple",
            "dev_simple",
            "test",
        }:
            errors.append(
                "PERSON_TRACKING_REQUIRE_EXTERNAL=true does not allow development_simple tracking backend"
            )
        if (
            self.person_tracking_backend.strip().lower() in {"development_simple", "simple", "dev_simple", "test"}
            and not self.person_tracking_allow_dev_simple
        ):
            errors.append("PERSON_TRACKING_ALLOW_DEV_SIMPLE=true is required for development_simple tracking backend")

        for raw_person_class_id in self.person_class_ids:
            try:
                parsed = int(raw_person_class_id)
                if parsed < 0:
                    errors.append("PERSON_CLASS_IDS must contain only non-negative integer values")
                    break
            except Exception:
                errors.append("PERSON_CLASS_IDS must contain only integer values")
                break

        if self.headwear_detector_mode.strip().lower() not in {"placeholder", "onnx_classifier", "onnx_detector"}:
            errors.append("HEADWEAR_DETECTOR_MODE has unsupported value")
        if self.headwear_input_width <= 0 or self.headwear_input_height <= 0:
            errors.append("HEADWEAR_INPUT_WIDTH and HEADWEAR_INPUT_HEIGHT must be > 0")
        if self.headwear_input_resize_mode.strip().lower() not in {"letterbox", "stretch"}:
            errors.append("HEADWEAR_INPUT_RESIZE_MODE must be one of: letterbox, stretch")
        if not (0 <= int(self.headwear_input_letterbox_pad_value) <= 255):
            errors.append("HEADWEAR_INPUT_LETTERBOX_PAD_VALUE must be in range [0, 255]")
        if not _in_unit_interval(self.headwear_classifier_conf_threshold):
            errors.append("HEADWEAR_CLASSIFIER_CONF_THRESHOLD must be in [0, 1]")
        if self.headwear_classifier_margin < 0:
            errors.append("HEADWEAR_CLASSIFIER_MARGIN must be >= 0")
        if not _in_unit_interval(self.headwear_detector_conf_threshold):
            errors.append("HEADWEAR_DETECTOR_CONF_THRESHOLD must be in [0, 1]")
        if not _in_unit_interval(self.headwear_detector_nms_iou):
            errors.append("HEADWEAR_DETECTOR_NMS_IOU must be in [0, 1]")
        if self.headwear_decision_margin < 0:
            errors.append("HEADWEAR_DECISION_MARGIN must be >= 0")
        if self.headwear_detector_box_format.strip().lower() not in {"cxcywh", "xyxy"}:
            errors.append("HEADWEAR_DETECTOR_BOX_FORMAT must be cxcywh or xyxy")
        if self.headwear_detector_has_objectness not in {"auto", "true", "false"}:
            errors.append("HEADWEAR_DETECTOR_HAS_OBJECTNESS must be auto/true/false")
        if self.headwear_detector_num_classes < 0:
            errors.append("HEADWEAR_DETECTOR_NUM_CLASSES must be >= 0")

        if self.head_detector_mode.strip().lower() not in {"disabled", "mock", "legacy", "legacy_geometry", "geometry", "onnx", "onnx_detector", "ultralytics"}:
            errors.append("HEAD_DETECTOR_MODE has unsupported value")
        if self.head_detector_run_scope.strip().lower() not in {"person_roi", "full_frame", "hybrid"}:
            errors.append("HEAD_DETECTOR_RUN_SCOPE must be one of: person_roi, full_frame, hybrid")
        if not _in_unit_interval(self.head_detector_conf_threshold):
            errors.append("HEAD_DETECTOR_CONF_THRESHOLD must be in [0, 1]")
        if not _in_unit_interval(self.head_detector_iou_threshold):
            errors.append("HEAD_DETECTOR_IOU_THRESHOLD must be in [0, 1]")
        if self.head_detector_input_size < 16:
            errors.append("HEAD_DETECTOR_INPUT_SIZE must be >= 16")
        if self.head_detector_box_format.strip().lower() not in {"cxcywh", "xyxy"}:
            errors.append("HEAD_DETECTOR_BOX_FORMAT must be cxcywh or xyxy")
        if self.head_detector_has_objectness not in {"auto", "true", "false"}:
            errors.append("HEAD_DETECTOR_HAS_OBJECTNESS must be auto/true/false")
        if self.head_detector_num_classes < 0:
            errors.append("HEAD_DETECTOR_NUM_CLASSES must be >= 0")
        if self.head_detector_min_head_width_px < 1 or self.head_detector_min_head_height_px < 1:
            errors.append("HEAD_DETECTOR_MIN_HEAD_WIDTH_PX and HEAD_DETECTOR_MIN_HEAD_HEIGHT_PX must be >= 1")
        if not _in_unit_interval(self.head_person_association_min_score):
            errors.append("HEAD_PERSON_ASSOCIATION_MIN_SCORE must be in [0, 1]")
        if not _in_unit_interval(self.head_person_association_min_inside_ratio):
            errors.append("HEAD_PERSON_ASSOCIATION_MIN_INSIDE_RATIO must be in [0, 1]")
        if self.head_person_association_ambiguity_delta < 0:
            errors.append("HEAD_PERSON_ASSOCIATION_AMBIGUITY_DELTA must be >= 0")
        if self.headwear_input_normalization_mode.strip().lower() not in {"none", "zero_one", "imagenet", "custom"}:
            errors.append("HEADWEAR_INPUT_NORMALIZATION_MODE must be none/zero_one/imagenet/custom")
        if self.headwear_classifier_binary_positive_means.strip().lower() not in {"violation", "compliant"}:
            errors.append("HEADWEAR_CLASSIFIER_BINARY_POSITIVE_MEANS must be violation/compliant")

        if self.face_embedder_mode.strip().lower() not in {"auto", "insightface", "none"}:
            errors.append("FACE_EMBEDDER_MODE must be auto/insightface/none")
        if self.body_embedder_mode.strip().lower() not in {
            "auto",
            "onnx",
            "handcrafted",
            "boxmot",
            "boxmot_osnet",
            "osnet",
            "neural_reid",
        }:
            errors.append("BODY_EMBEDDER_MODE must be auto/onnx/handcrafted/boxmot/boxmot_osnet/osnet/neural_reid")
        if self.body_embedding_input_width <= 0 or self.body_embedding_input_height <= 0:
            errors.append("BODY_EMBEDDING_INPUT_WIDTH and BODY_EMBEDDING_INPUT_HEIGHT must be > 0")
        if self.identity_max_day_people < 1:
            errors.append("IDENTITY_MAX_DAY_PEOPLE must be >= 1")
        if self.identity_embedding_gallery_size < 1:
            errors.append("IDENTITY_EMBEDDING_GALLERY_SIZE must be >= 1")

        if self.evidence_jpeg_quality < 1 or self.evidence_jpeg_quality > 100:
            errors.append("EVIDENCE_JPEG_QUALITY must be in [1, 100]")
        if self.evidence_retention_days < 1:
            errors.append("EVIDENCE_RETENTION_DAYS must be >= 1")
        if self.evidence_cleanup_interval_sec <= 0:
            errors.append("EVIDENCE_CLEANUP_INTERVAL_SEC must be > 0")

        if self.backend_max_retries < 0:
            errors.append("BACKEND_MAX_RETRIES must be >= 0")
        if self.backend_retry_delay_sec < 0:
            errors.append("BACKEND_RETRY_DELAY_SEC must be >= 0")
        if self.backend_queue_maxsize < 1:
            errors.append("BACKEND_QUEUE_MAXSIZE must be >= 1")
        if self.backend_worker_poll_interval_ms < 1:
            errors.append("BACKEND_WORKER_POLL_INTERVAL_MS must be >= 1")
        if self.backend_enabled:
            if not self.backend_base_url.strip():
                errors.append("BACKEND_BASE_URL must not be empty when BACKEND_ENABLED=true")
            if self.backend_timeout_sec <= 0:
                errors.append("BACKEND_TIMEOUT_SEC must be > 0 when BACKEND_ENABLED=true")

        reid_weight_sum = (
            self.reid_face_weight
            + self.reid_body_weight
            + self.reid_position_weight
            + self.reid_time_weight
            + self.reid_size_weight
        )
        if reid_weight_sum <= 0:
            errors.append("Sum of REID_*_WEIGHT values must be > 0")

        for name, value in (
            ("REID_FACE_WEIGHT", self.reid_face_weight),
            ("REID_BODY_WEIGHT", self.reid_body_weight),
            ("REID_POSITION_WEIGHT", self.reid_position_weight),
            ("REID_TIME_WEIGHT", self.reid_time_weight),
            ("REID_SIZE_WEIGHT", self.reid_size_weight),
        ):
            if value < 0:
                errors.append(f"{name} must be >= 0")

        if errors:
            raise ValueError("Invalid runtime configuration: " + "; ".join(errors))

    def validate_runtime_launch_or_raise(
        self,
        *,
        source_url: str,
        require_real_headwear: bool | None = None,
    ) -> None:
        self.validate_runtime_static_config_or_raise()

        errors: list[str] = []

        if not source_url.strip():
            errors.append("SOURCE_URL is empty and runtime.export-video did not receive a source_url")

        tracking_backend = self.person_tracking_backend.strip().lower()
        if tracking_backend in {"disabled", "none", "off"}:
            errors.append("PERSON_TRACKING_BACKEND must not be disabled for export-video")
        if tracking_backend in {"development_simple", "simple", "dev_simple", "test"}:
            if self.person_tracking_require_external:
                errors.append("PERSON_TRACKING_REQUIRE_EXTERNAL=true rejects development_simple tracking backend")
            if not self.person_tracking_allow_dev_simple:
                errors.append("PERSON_TRACKING_ALLOW_DEV_SIMPLE=true is required for development_simple tracking backend")
        if tracking_backend in {"ultralytics", "yolo", "yolo_track", "botsort", "bytetrack"}:
            yolo_path = Path(self.yolo_model_path).expanduser() if self.yolo_model_path.strip() else None
            if yolo_path is None:
                errors.append("PERSON_MODEL_PATH is required for Ultralytics person tracking")
            elif not self.person_allow_ultralytics_auto_download and not yolo_path.is_file():
                errors.append(f"PERSON_MODEL_PATH does not exist locally: {yolo_path}")

        headwear_mode = self.headwear_detector_mode.strip().lower()
        collection_mode = bool(getattr(self, "person_crop_collection_enabled", False))
        must_require_real_headwear = self.runtime_require_real_headwear if require_real_headwear is None else require_real_headwear
        if collection_mode:
            must_require_real_headwear = False

        if must_require_real_headwear and headwear_mode == "placeholder":
            errors.append("HEADWEAR_DETECTOR_MODE=placeholder is not allowed for target export-video")

        head_detector_mode = self.head_detector_mode.strip().lower()
        if must_require_real_headwear and head_detector_mode in {"disabled", "mock", "off", "none"}:
            errors.append("HEAD_DETECTOR_MODE=disabled/mock is not allowed when RUNTIME_REQUIRE_REAL_HEADWEAR=true")
        if head_detector_mode in {"onnx", "onnx_detector"}:
            if not self.head_detector_model_path.strip():
                errors.append("HEAD_DETECTOR_MODEL_PATH must not be empty for ONNX head detector")
            else:
                head_path = Path(self.head_detector_model_path).expanduser()
                if not head_path.is_file():
                    errors.append(f"HEAD_DETECTOR_MODEL_PATH does not exist locally: {head_path}")
        if head_detector_mode in {"legacy", "legacy_geometry", "geometry"} and not self.allow_legacy_geometry_head_fallback:
            errors.append("ALLOW_LEGACY_GEOMETRY_HEAD_FALLBACK=true is required for legacy geometry head detector")

        if must_require_real_headwear and headwear_mode in {"onnx_classifier", "onnx_detector"}:
            if not self.headwear_model_path.strip():
                errors.append("HEADWEAR_MODEL_PATH must not be empty for ONNX headwear detector")
            else:
                headwear_path = Path(self.headwear_model_path).expanduser()
                if not headwear_path.is_file():
                    errors.append(f"HEADWEAR_MODEL_PATH does not exist locally: {headwear_path}")

        if self.body_embedder_mode.strip().lower() == "onnx" and self.body_embedder_strict_backend:
            if not self.body_embedding_model_path.strip():
                errors.append(
                    "BODY_EMBEDDING_MODEL_PATH must not be empty when BODY_EMBEDDER_MODE=onnx "
                    "and BODY_EMBEDDER_STRICT_BACKEND=true"
                )
            else:
                body_path = Path(self.body_embedding_model_path).expanduser()
                if not body_path.is_file():
                    errors.append(f"BODY_EMBEDDING_MODEL_PATH does not exist locally: {body_path}")

        if errors:
            raise ValueError("Runtime export rejected: " + "; ".join(errors))


