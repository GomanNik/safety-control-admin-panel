# ============================================================
# .env loading
# ============================================================

_PROJECT_ROOT = Path(__file__).resolve().parents[1]


def _unquote_env_value(value: str) -> str:
    text = value.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in {'"', "'"}:
        return text[1:-1]
    return text


def _load_env_file(env_file: Path) -> Path | None:
    if not env_file.exists() or not env_file.is_file():
        return None

    try:
        for raw_line in env_file.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                continue

            key, value = line.split("=", 1)
            key = key.strip()
            value = _unquote_env_value(value)
            if key and key not in os.environ:
                os.environ[key] = value
    except Exception:
        return None

    return env_file


def _load_project_env() -> Path | None:
    explicit_env_file = os.getenv("VISION_ENV_FILE", "").strip()
    if explicit_env_file:
        return _load_env_file(Path(explicit_env_file).expanduser().resolve())

    return _load_env_file(_PROJECT_ROOT / ".env")


_ENV_FILE_PATH = _load_project_env()
_ENV_BASE_DIR = _ENV_FILE_PATH.parent if _ENV_FILE_PATH is not None else _PROJECT_ROOT


# ============================================================
# Helpers
# ============================================================

def _as_names(names: str | tuple[str, ...] | list[str]) -> tuple[str, ...]:
    if isinstance(names, str):
        return (names,)
    return tuple(names)


def _first_env_value(names: str | tuple[str, ...] | list[str]) -> str | None:
    for name in _as_names(names):
        value = os.getenv(name)
        if value is None:
            continue
        normalized = value.strip()
        if normalized:
            return normalized
    return None


def _parse_bool(value: str) -> bool:
    normalized = value.strip().lower()
    if normalized in {"1", "true", "yes", "on"}:
        return True
    if normalized in {"0", "false", "no", "off"}:
        return False
    raise ValueError(f"Unsupported boolean value: {value}")


def _env_str(names: str | tuple[str, ...] | list[str], default: str) -> str:
    value = _first_env_value(names)
    return value if value is not None else default


def _env_int(names: str | tuple[str, ...] | list[str], default: int) -> int:
    value = _first_env_value(names)
    if value is None:
        return default
    try:
        return int(value)
    except Exception:
        return default


def _env_float(names: str | tuple[str, ...] | list[str], default: float) -> float:
    value = _first_env_value(names)
    if value is None:
        return default
    try:
        return float(value)
    except Exception:
        return default


def _env_bool(names: str | tuple[str, ...] | list[str], default: bool) -> bool:
    value = _first_env_value(names)
    if value is None:
        return default
    try:
        return _parse_bool(value)
    except Exception:
        return default


def _env_csv(names: str | tuple[str, ...] | list[str], default: tuple[str, ...] = ()) -> tuple[str, ...]:
    value = _first_env_value(names)
    if value is None:
        return default

    items = [item.strip() for item in value.split(",") if item.strip()]
    return tuple(items) if items else default


def _env_float_triplet(names: str | tuple[str, ...] | list[str]) -> tuple[float, float, float] | None:
    value = _first_env_value(names)
    if value is None:
        return None

    parts = [item.strip() for item in value.split(",") if item.strip()]
    if len(parts) != 3:
        return None

    try:
        return float(parts[0]), float(parts[1]), float(parts[2])
    except Exception:
        return None


def _resolve_person_detector_mode() -> str:
    explicit_mode = _first_env_value("PERSON_DETECTOR_MODE")
    if explicit_mode is not None:
        return explicit_mode

    legacy_use_yolo = _first_env_value("USE_YOLO")
    if legacy_use_yolo is not None:
        try:
            return "ultralytics" if _parse_bool(legacy_use_yolo) else "auto"
        except Exception:
            return "auto"

    return "auto"


def _normalize_tristate(value: str | None, default: str = "auto") -> str:
    if value is None:
        return default

    normalized = value.strip().lower()
    if normalized in {"1", "true", "yes", "on"}:
        return "true"
    if normalized in {"0", "false", "no", "off"}:
        return "false"
    return "auto"


def _in_unit_interval(value: float) -> bool:
    return 0.0 <= float(value) <= 1.0


def _is_probable_url(value: str) -> bool:
    lowered = value.strip().lower()
    return (
        lowered.startswith("rtsp://")
        or lowered.startswith("rtsps://")
        or lowered.startswith("http://")
        or lowered.startswith("https://")
        or lowered.startswith("udp://")
        or lowered.startswith("tcp://")
    )


def _resolve_path(value: str) -> str:
    text = value.strip()
    if not text:
        return text
    if _is_probable_url(text):
        return text

    path = Path(text).expanduser()
    if path.is_absolute():
        return str(path)

    return str((_ENV_BASE_DIR / path).resolve())


