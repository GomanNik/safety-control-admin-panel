        self.boxmot_reid_weights_path = _resolve_path(self.boxmot_reid_weights_path) if self.boxmot_reid_weights_path.strip() else ""

    def validate_app_config_or_raise(self) -> None:
        errors: list[str] = []

        if not self.app_name.strip():
            errors.append("APP_NAME must not be empty")
        if not self.app_host.strip():
            errors.append("APP_HOST must not be empty")
        if not (1 <= int(self.app_port) <= 65535):
            errors.append("APP_PORT must be in range [1, 65535]")
        if self.log_level.strip().upper() not in {"CRITICAL", "ERROR", "WARNING", "INFO", "DEBUG", "NOTSET"}:
            errors.append("LOG_LEVEL must be one of CRITICAL, ERROR, WARNING, INFO, DEBUG, NOTSET")

        if errors:
            raise ValueError("Invalid app configuration: " + "; ".join(errors))

    def validate_runtime_static_config_or_raise(self) -> None:
        errors: list[str] = []

        if not self.camera_id.strip():
            errors.append("CAMERA_ID must not be empty")
        if not self.evidence_dir.strip():
            errors.append("EVIDENCE_DIR must not be empty")
        if not self.processed_video_dir.strip():
            errors.append("PROCESSED_VIDEO_DIR must not be empty")

        if self.startup_source_probe_timeout_sec <= 0:
            errors.append("STARTUP_SOURCE_PROBE_TIMEOUT_SEC must be > 0")
        if self.startup_source_probe_poll_interval_ms < 1:
            errors.append("STARTUP_SOURCE_PROBE_POLL_INTERVAL_MS must be >= 1")

        if self.processed_video_fps <= 0:
            errors.append("PROCESSED_VIDEO_FPS must be > 0")
        if self.processed_video_analysis_fps <= 0:
            errors.append("PROCESSED_VIDEO_ANALYSIS_FPS must be > 0")
        if self.tracking_fps <= 0:
            errors.append("TRACKING_FPS must be > 0")
        if self.headwear_classification_fps <= 0:
            errors.append("HEADWEAR_CLASSIFICATION_FPS must be > 0")
        if self.processed_video_status_update_every_frames < 1:
            errors.append("PROCESSED_VIDEO_STATUS_UPDATE_EVERY_FRAMES must be >= 1")
        if self.processed_video_max_width < 0:
            errors.append("PROCESSED_VIDEO_MAX_WIDTH must be >= 0")
        if self.processed_video_max_seconds < 0:
